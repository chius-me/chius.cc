{
  "name": "hugo",
  "main": "src/index.js",
  "compatibility_date": "2024-12-18",
  // Keep workers.dev URL available (default flips when routes/custom domains
  // are declared in config; domains for this site are managed in the dashboard).
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
